# ==============================================================================
# Resonance Environment Configuration Template
# Copy this file to `.env` for local development. Never commit real credentials or keys.
# ==============================================================================

# Backend Service Configuration (Node.js / Express / Socket.IO)
PORT=4000
NODE_ENV=development
MAX_BODY_SIZE=50kb

# Frontend Client Configuration (Vite / React)
# Used for CORS whitelist on backend and direct client-side socket connection
CLIENT_ORIGIN=http://localhost:5173
VITE_BACKEND_URL=http://localhost:4000

# Sensor Simulator Configuration (Python)
# Planned HTTP ingest endpoint where the Python simulator delivers validated JSON events
SIMULATOR_API_URL=http://localhost:4000/api/sensor-data
SIMULATOR_SENSOR_ID=Pillar_A
SIMULATOR_STREAM_INTERVAL_MS=1000

# Logging & Telemetry
LOG_LEVEL=info
